{
  "name": "forcedeck",
  "meta": {
    "source": "forcedeck",
    "endpoint": "/v1/tests",
    "table": "stg_forcedeck",
    "notes": "Validated against silver.<table>: Bronze unpacked, deduplicated, units converted. in_set/regex/between ignore NULLs; pair not_null expectations where a value is required."
  },
  "expectations": [
    {
      "type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "test_id"
      }
    },
    {
      "type": "expect_column_values_to_be_unique",
      "kwargs": {
        "column": "test_id"
      }
    },
    {
      "type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "athlete_gsis_id",
        "regex": "^00-00\\d{5}$"
      }
    },
    {
      "type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "test_ts"
      }
    },
    {
      "type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "test_type"
      }
    },
    {
      "type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "test_type",
        "value_set": [
          "CMJ",
          "IMTP",
          "DJ"
        ]
      }
    },
    {
      "type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "rep",
        "min_value": 1,
        "max_value": 3
      }
    },
    {
      "type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "jump_height_cm",
        "min_value": 5,
        "max_value": 90
      }
    },
    {
      "type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "peak_force_n",
        "min_value": 800,
        "max_value": 7000
      }
    },
    {
      "type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "rfd",
        "min_value": 1000,
        "max_value": 20000
      }
    },
    {
      "type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "asymmetry_pct",
        "min_value": -50,
        "max_value": 50
      }
    }
  ]
}
