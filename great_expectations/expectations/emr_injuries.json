{
  "name": "emr_injuries",
  "meta": {
    "source": "emr",
    "endpoint": "/v1/injuries",
    "table": "stg_emr_injuries",
    "notes": "Validated against silver.<table>: Bronze unpacked, deduplicated, units converted. in_set/regex/between ignore NULLs; pair not_null expectations where a value is required."
  },
  "expectations": [
    {
      "type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "injury_id"
      }
    },
    {
      "type": "expect_column_values_to_be_unique",
      "kwargs": {
        "column": "injury_id"
      }
    },
    {
      "type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "player"
      }
    },
    {
      "type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "team",
        "regex": "^[A-Z]{2,3}$"
      }
    },
    {
      "type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "event_ts"
      }
    },
    {
      "type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "body_part"
      }
    },
    {
      "type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "side",
        "value_set": [
          "L",
          "R"
        ]
      }
    },
    {
      "type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "injury_type",
        "value_set": [
          "strain",
          "sprain",
          "contusion",
          "fracture",
          "concussion",
          "illness"
        ]
      }
    },
    {
      "type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "severity",
        "value_set": [
          "minor",
          "moderate",
          "major"
        ]
      }
    },
    {
      "type": "expect_column_pair_values_a_to_be_greater_than_b",
      "kwargs": {
        "column_A": "expected_rtp",
        "column_B": "event_date",
        "or_equal": true,
        "ignore_row_if": "either_value_is_missing"
      }
    }
  ]
}
