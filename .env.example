# Copy to .env and adjust. Compose falls back to these same values if unset.

# Warehouse Postgres (medallion schemas; exposed on localhost:5432)
WAREHOUSE_DB=warehouse
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=warehouse

# Airflow metadata Postgres (separate instance, internal only)
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow

# Airflow UI login + session signing key
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_SECRET_KEY=change-me-local-only
