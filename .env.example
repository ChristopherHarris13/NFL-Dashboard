# Copy to .env and adjust. Compose falls back to these same values if unset.

# Warehouse Postgres (exposed on localhost:5432)
WAREHOUSE_DB=warehouse
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=warehouse

# Airflow metadata DB (a second database inside the same Postgres container)
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow

# Signs API/UI session tokens; change for anything beyond local dev
AIRFLOW_JWT_SECRET=change-me-local-only
