model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Player Day","Player","Date","Injury","Injury Status","Force Plate Test","DQ Run"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table 'Player Day'
ref table Player
ref table Date
ref table Injury
ref table 'Injury Status'
ref table 'Force Plate Test'
ref table 'DQ Run'
ref table AsOf
ref table Window
ref table 'Key Measures'

ref cultureInfo en-US

